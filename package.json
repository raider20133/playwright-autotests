{
  "name": "chronos-autotests",
  "version": "2.0.0",
  "description": "API + UI test automation for the Chronos management app, built with Playwright and TypeScript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "deploy:allure": "gh-pages -d allure-report -b gh-pages"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-playwright": "^2.12.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  }
}
